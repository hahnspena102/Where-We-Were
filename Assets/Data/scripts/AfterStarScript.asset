  m_Script: {fileID: 11500000, guid: 0d1144f89f22e429abc53db6888903c4, type: 3}
  m_Name: AfterStarScript
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - "The universe is ever so vast. Sometimes, it feels like you\u2019re a lonely
    star with nothing else around you. But when you take the moment to look around
    you, you begin to see that the universe is bright with millions of stars and
    you learn that you aren\u2019t so alone."
